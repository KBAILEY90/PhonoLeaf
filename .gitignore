# Node / Capacitor
node_modules/
www/

# Android build outputs (the android/ project itself IS committed)
android/.gradle/
android/.idea/
android/build/
android/app/build/
android/local.properties
android/app/release/

# IDE state (created when Android Studio opened the repo root by mistake)
.idea/

# Entitlement Worker (worker/) — local wrangler state and dev secrets.
# node_modules/ above already covers worker/node_modules/.
worker/.wrangler/
worker/.dev.vars
