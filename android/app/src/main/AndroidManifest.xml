<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- Portrait-locked: rotating re-flows the epub into a different column
             layout, which changes the page count/positions under the reader and
             made a page-end auto-advance jump backwards several pages. The UI is
             portrait-first anyway (matches manifest.json's "orientation").
             Supporting landscape properly means re-anchoring to the current CFI
             and resetting the page-turn corrector on resize — a later job. -->
        <activity
            android:screenOrientation="portrait"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- OAuth return deep link (system-browser sign-in). Scheme is the
                 REVERSED Android OAuth client id (Cloud Console > Credentials
                 > PhonoLeaf Android (debug)). If that client is ever
                 recreated, update this AND CONFIG.ANDROID_CLIENT_ID together. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="com.googleusercontent.apps.88179965472-cs9869nsk2b9i00v5ebo8sd9mrq9kmmn" />
            </intent-filter>

        </activity>

        <!-- Keeps the WebView's <audio> sentence-chain alive when backgrounded /
             screen off. See PlaybackService.kt. exported=false: only we start it. -->
        <service
            android:name=".PlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Keeps a voice-pack download (65-140 MB) alive when the screen locks
             mid-download. See PackDownloadService.kt. exported=false: only we
             start it. foregroundServiceType="dataSync" is Android's own type for
             "transferring data through the network and shouldn't be interrupted
             by the system" — a different type than PlaybackService's
             mediaPlayback, since this is a different kind of work. -->
        <service
            android:name=".PackDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- The speech engine, in its OWN PROCESS (android:process=":tts").
             Not an optimisation: espeak-ng is GPL-3.0 and is statically linked
             into the sherpa-onnx native library, so it is kept behind a process
             boundary and spoken to only through the ITtsService AIDL interface.
             PhonoLeaf's own code never links it. See TODO.md's voice model
             licence section and TtsService.kt.
             exported=false: only we bind to it, never another app. Android may
             kill this process under memory pressure, which is expected and
             harmless — the next synthesize() reloads the model. -->
        <service
            android:name=".TtsService"
            android:exported="false"
            android:process=":tts" />
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Background/lock-screen audio: our own PlaybackService.kt runs a
         foreground service (NOT @jofr/capacitor-media-session — that plugin
         crashed the app and was removed, see PlaybackService.kt's header).
         Android 14+ (targetSdk 36) requires FOREGROUND_SERVICE_MEDIA_PLAYBACK
         for any mediaPlayback FGS or it crashes; POST_NOTIFICATIONS
         (Android 13+) lets the media notification show. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- PackDownloadService: keeps a voice-pack download running with the
         screen off (Android 14+/targetSdk 36 requires this for any dataSync
         FGS, same rule that already applies to FOREGROUND_SERVICE_MEDIA_PLAYBACK
         above). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- PARTIAL (CPU) wake lock: the foreground service stops the app being
         killed, but not the CPU sleeping when the screen locks — and every
         sentence needs the CPU for the JS loop + Piper inference. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
</manifest>
